# ============================================
# Deep Research From Scratch - Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================

# Required for research agents with external search
TAVILY_API_KEY=your_tavily_api_key_here

# Local LLM configuration
LOCAL_LLM_PROVIDER=lmstudio
LOCAL_LLM_MODEL=your_local_model_name_here
LOCAL_LLM_MODEL_PATH=path_to_your_local_model_here

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Backward-compatible fallback (used only when LOCAL_LLM_PROVIDER=ollama)
OLLAMA_MODEL=your_ollama_model_here

GOOGLE_API_KEY=your_google_api_key_here

# Optional: For LangSmith evaluation and tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deep_research_from_scratch
